.trk li.d,.trk li.c{color:#222}.trk b{display:block;font:600 12px Inter}.trk small{display:block;font-size:11px;color:#777;min-height:14px}
.oa{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
