sale:()=>{const l=SALE.slice();if(SORT=="lo")l.sort((a,b)=>a.p-b.p);if(SORT=="hi")l.sort((a,b)=>b.p-a.p);return `<div class="wrap"><h1 class="ct">Sale</h1><div class="bar"><select id="so" aria-label="Sort"><option value="def">Sort: Featured</option><option value="lo">Price: low to high</option><option value="hi">Price: high to low</option></select></div><div style="height:16px"></div>${grid(l)}</div>`},
