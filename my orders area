<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Urban Kinda | where style meets individuality</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Lora:wght@400;500;600;700&family=Outfit:wght@400;500;600&family=Pinyon+Script&display=swap">
<style>
:root{color-scheme:light;--pad:clamp(20px,4vw,80px);--bar:#d9d9d9;--mar:#710000;--brown:#4a2a14;--ink:#111;--mut:#9a9a9a;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:calc(96px + env(safe-area-inset-top,0px));scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:#fff;color:var(--ink);font-family:Outfit,sans-serif;min-height:100vh;display:flex;flex-direction:column}
main{flex:1;width:100%}
a{color:inherit;text-decoration:none}button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--mar);outline-offset:2px}
svg{fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:30;background:var(--bar);box-shadow:0 3px 3px rgba(0,0,0,.3)}
.nav{display:flex;align-items:center;height:80px;padding:0 var(--pad);gap:20px;margin:auto}
.lg img{height:clamp(60px,4.2vw,76px);display:block;mix-blend-mode:multiply;transition:transform .25s}
.lg:hover img{transform:scale(1.06)}
nav{margin-left:auto;display:flex;gap:clamp(30px,3vw,64px);font:500 clamp(18px,1.3vw,24px) Lora,serif}
nav a{position:relative;padding:4px 0;transition:color .2s}
nav a:after{content:"";position:absolute;left:0;right:0;bottom:-2px;height:2px;background:var(--brown);transform:scaleX(0);transition:transform .25s}
nav a:hover,nav a.on{color:var(--brown)}nav a:hover:after,nav a.on:after{transform:none}
.ic{display:flex;gap:4px}
.ib{position:relative;width:46px;height:46px;border:0;background:none;border-radius:50%;display:grid;place-items:center;transition:background .2s,transform .15s,color .2s}
.ib:hover{background:rgba(0,0,0,.09);transform:scale(1.12)}.ib:active{transform:scale(.88)}
.ib svg{width:28px;height:28px}
.ib.on{color:#e11d1d}
#mb{display:none}
.bd{position:absolute;top:2px;right:0;background:var(--mar);color:#fff;font:600 11px Outfit;min-width:18px;height:18px;border-radius:9px;display:grid;place-items:center;padding:0 4px}
.bd:empty{display:none}.bd.bump{animation:bump .4s}
@keyframes bump{50%{transform:scale(1.6)}}
.wrap{max-width:1920px;margin:auto;padding:0 var(--pad)}
.pgi{animation:fi .35s ease}
@keyframes fi{from{opacity:0;transform:translateY(8px)}}
.call{display:inline-flex;align-items:center;gap:10px;font:700 clamp(15px,1.1vw,19px) Lora,serif;padding-top:14px;transition:transform .2s}
.call:hover{transform:translateX(4px)}
.call i{width:28px;height:28px;border-radius:50%;background:#1be31b;display:grid;place-items:center}
.call svg{width:16px;height:16px;fill:#fff;stroke:none}
.hero{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:30px;min-height:calc(100vh - 150px)}
.cp{align-self:center;padding:16px 0}
.sc{font:400 clamp(32px,3vw,52px) 'Pinyon Script',cursive;color:#8b1a24;margin:0}
.hl{font:500 clamp(34px,4.6vw,76px)/1.15 Lora,serif;margin:2px 0 16px;max-width:12ch}
.d{font-size:clamp(14px,1.25vw,20px);line-height:1.55;max-width:34em;margin:0 0 24px}
.hero img{width:100%;max-width:min(44vw,580px);justify-self:end;display:block}
.rp{position:relative;overflow:hidden}
.rp span{position:absolute;border-radius:50%;background:rgba(255,255,255,.45);transform:scale(0);animation:rip .55s linear;pointer-events:none}
@keyframes rip{to{transform:scale(4);opacity:0}}
.sb{background:var(--mar);color:#fff;border:0;border-radius:3px;padding:10px 18px;font:600 13px Outfit;box-shadow:0 4px 10px rgba(180,0,0,.4);transition:transform .15s,box-shadow .2s,filter .2s}
.sb:hover{transform:translateY(-2px);box-shadow:0 8px 16px rgba(180,0,0,.45);filter:brightness(1.15)}.sb:active{transform:scale(.95)}
.ct{text-align:center;font:800 clamp(32px,2.6vw,46px) Inter,sans-serif;margin:26px 0 14px}
.sec h2{font:800 clamp(34px,2.6vw,48px) Inter,sans-serif;margin:30px 0 18px}
.bar{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:6px}
.chip{border:1px solid #ccc;background:#fff;border-radius:20px;padding:7px 16px;font:600 13px Inter;transition:.2s}
.chip:hover{border-color:var(--mar);color:var(--mar);transform:translateY(-2px)}
.chip.on{background:var(--mar);border-color:var(--mar);color:#fff}
select{font:600 13px Inter;padding:8px 10px;border:1px solid #ccc;border-radius:6px;background:#fff}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(16px,1.6vw,32px)}
.card{background:#fff;border-radius:3px;box-shadow:0 1px 4px rgba(0,0,0,.2);transition:transform .25s,box-shadow .25s}
.card:hover{transform:translateY(-6px);box-shadow:0 12px 24px rgba(0,0,0,.22)}
.iw{position:relative;overflow:hidden;aspect-ratio:206/222}
.iw img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
.card:hover .iw img{transform:scale(1.07)}
.hb{position:absolute;top:8px;right:8px;width:36px;height:36px;border-radius:50%;border:0;background:rgba(255,255,255,.92);display:grid;place-items:center;opacity:0;transform:scale(.8);transition:.2s;color:#222}
.card:hover .hb,.hb.on,.hb:focus-visible{opacity:1;transform:none}
.hb svg{width:20px;height:20px}.hb.on{color:#e11d1d}.hb.on svg{fill:#e11d1d}
.hb.pop{animation:pop .4s}
@keyframes pop{40%{transform:scale(1.45)}}
@media (hover:none){.hb{opacity:1;transform:none}}
.mt{padding:8px 10px 12px}
.mt h3{font:700 clamp(13px,1vw,17px) Inter;margin:2px 0 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pr{font:500 clamp(21px,1.6vw,28px) Inter;color:var(--mar)}.pr s{font-size:12px;color:var(--mut);margin-left:2px}
.sw{display:flex;gap:9px;margin:9px 0 11px;min-height:20px;align-items:center}
.sw button{width:16px;height:16px;border-radius:50%;border:1px solid rgba(0,0,0,.2);background:var(--c);padding:0;transition:transform .15s}
.sw button:hover{transform:scale(1.25)}
.sw button.on{outline:2px solid color-mix(in srgb,var(--c) 70%,#555);outline-offset:2px}
.ac{display:flex;gap:10px;align-items:center}
.buy{flex:1;background:var(--mar);color:#fff;border:0;border-radius:3px;padding:9px;font:700 13px Inter;transition:filter .2s,transform .15s}
.buy:hover{filter:brightness(1.25)}.buy:active{transform:scale(.95)}
.ca{background:none;border:0;color:var(--mar);width:34px;height:34px;display:grid;place-items:center;border-radius:50%;transition:.2s}
.ca svg{width:24px;height:24px}.ca:hover{background:#f3e3e3;transform:scale(1.15)}.ca:active{transform:scale(.85)}
.em{text-align:center;color:#555;padding:50px 0;grid-column:1/-1}
.em .sb{margin-top:14px}
.cr{display:grid;grid-template-columns:clamp(166px,13vw,240px) 1fr auto;gap:clamp(18px,2vw,36px);align-items:start;margin:0 0 34px}
.cr img{width:100%;aspect-ratio:166/145;object-fit:cover;display:block}
.cr h3{font:700 clamp(20px,1.6vw,28px) Inter;margin:0 0 4px}
.cr .pr{font-size:22px}
.rm{background:none;border:0;color:#666;text-decoration:underline;font-size:13px;padding:0}.rm:hover{color:var(--mar)}
.q{display:flex;align-items:center;gap:14px;font:700 22px Inter;padding-top:30px}
.q button{background:#000;border:0;border-radius:6px;width:34px;height:28px;display:grid;place-items:center;color:#fff;transition:.15s}
.q button:hover{background:var(--mar);transform:scale(1.1)}.q button:active{transform:scale(.88)}
.q svg{width:18px;height:18px}
.tot{margin:0 0 40px;border-top:1px solid #ddd;padding-top:16px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;font:700 22px Inter}
.tot small{display:block;font:400 13px Outfit;color:#2a7a2a}
.ab{text-align:center;position:relative;padding:20px 0 10px}
.bk{position:absolute;left:0;top:22px;font:400 18px Lora,serif;background:none;border:0;padding:6px 0;transition:.2s}.bk:hover{color:var(--mar);transform:translateX(-4px)}
.ab h1{font:800 clamp(38px,6vw,84px) Inter;color:var(--mar);margin:8px 0 18px}
.ab p{font:400 clamp(17px,1.35vw,23px)/1.5 Lora,serif;max-width:1100px;margin:0 auto 22px}
.fb{text-align:center;padding-top:10px}.fb img{display:block;margin:0 auto}
footer{max-width:1920px;width:100%;margin:30px auto 0;padding:20px var(--pad) 34px;display:grid;grid-template-columns:auto 1fr auto;gap:40px;align-items:start}
footer h4{font:500 clamp(28px,2vw,36px) Lora,serif;color:var(--mar);margin:0 0 14px}
footer a{display:block;font:400 clamp(18px,1.3vw,22px) Lora,serif;margin-bottom:12px;transition:.2s;width:fit-content}
footer a:hover{color:var(--mar);transform:translateX(4px)}
.pm{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.pm span{display:grid;place-items:center;height:52px;min-width:76px;padding:0 14px;border:1px solid #e3e3e3;border-radius:10px;background:#fff;transition:.2s}
.pm span:hover{border-color:var(--mar);transform:translateY(-3px);box-shadow:0 6px 14px rgba(0,0,0,.1)}
.pm img{height:32px;width:auto;max-width:72px;object-fit:contain;display:block}
#ov{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:40;display:none}
#ov.open{display:block;animation:fi .2s}
#sp{position:fixed;z-index:41;top:calc(96px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);width:min(900px,94vw);background:#fff;border-radius:6px;box-shadow:0 10px 30px rgba(0,0,0,.3);padding:10px 14px 14px;display:none}
#sp.open{display:block;animation:fi .2s}
#sp form{display:flex;align-items:center;gap:10px;border-bottom:1px solid #ddd;padding-bottom:10px}
#sp svg{width:18px;height:18px;flex:none}
#sp input{flex:1;border:0;font:400 14px Outfit;outline:0;padding:8px 0}
#sp li{list-style:none}#sp ul{margin:8px 0 0;padding:0}
#sp li button{display:flex;gap:14px;align-items:center;width:100%;border:0;background:none;text-align:left;padding:9px 10px;color:#666;font-size:14px;border-radius:4px;transition:.15s}
#sp li button:hover{background:#f3f0f0;color:var(--mar);padding-left:16px}
.md{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.5);display:none;place-items:center;padding:16px}
.md.open{display:grid}
.md form{background:#fff;border-radius:8px;padding:24px;width:min(440px,100%);max-height:94vh;overflow:auto;animation:fi .25s}
.md h2{font:700 24px Lora,serif;margin:0 0 14px}
.md input[type=text],.md input[type=tel],.md textarea{width:100%;padding:10px;margin-bottom:10px;border:1px solid #ccc;border-radius:4px;font:inherit}
.md input:focus,.md textarea:focus{border-color:var(--mar);outline:0;box-shadow:0 0 0 3px #71000022}
.po{display:grid;gap:8px;margin:8px 0 16px}
.po label{display:flex;align-items:center;gap:12px;border:1px solid #e0e0e0;border-radius:8px;padding:10px 14px;cursor:pointer;font:500 14px Outfit;transition:.2s}
.po label:hover{border-color:#999;transform:translateX(3px)}
.po label:has(input:checked){border-color:var(--mar);background:#fbf1f1}
.po input{position:absolute;opacity:0}
.po i{width:16px;height:16px;border-radius:50%;border:2px solid #bbb;flex:none;transition:.2s}
.po input:checked+i{border-color:var(--mar);background:radial-gradient(var(--mar) 45%,#fff 50%)}
.po input:focus-visible+i{outline:3px solid var(--mar);outline-offset:2px}
.po img{height:26px;width:46px;object-fit:contain}
.md .sb{width:100%;padding:12px}
.x{float:right;background:none;border:0;font-size:26px;line-height:1}
#t{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);background:#222;color:#fff;padding:10px 18px;border-radius:6px;opacity:0;transition:.25s;z-index:60;pointer-events:none;font-size:14px}
#t.show{opacity:1;transform:translate(-50%,0)}
.au{max-width:480px;margin:30px auto;background:#fff;border-radius:8px;box-shadow:0 4px 18px rgba(0,0,0,.18);overflow:hidden}
.tabs{display:flex}.tabs button{flex:1;border:0;background:#f1f1f1;padding:14px;font:600 15px Inter;border-bottom:3px solid transparent;transition:.2s}
.tabs button:hover{background:#e8e8e8}.tabs button.on{background:#fff;color:var(--mar);border-color:var(--mar)}
.au form,.au .bx{padding:24px}.au h2{font:700 26px Lora,serif;margin:0 0 4px}.sub{color:#666;font-size:14px;margin:0 0 18px}
label.f{display:block;font:600 13px Inter;margin-bottom:12px}
.f input{width:100%;margin-top:5px;padding:11px;border:1px solid #ccc;border-radius:4px;font:400 15px Outfit;transition:.2s}
.f input:focus{border-color:var(--mar);outline:0;box-shadow:0 0 0 3px #71000022}
.pw{display:block;position:relative}.pw button{position:absolute;right:6px;bottom:5px;border:0;background:none;color:#666;font:600 12px Inter;padding:6px 8px}.pw button:hover{color:var(--mar)}
.sm{height:5px;background:#e5e5e5;border-radius:3px;margin:-4px 0 4px;overflow:hidden}.sm i{display:block;height:100%;width:0;transition:.3s}
.er{color:#b00020;font-size:13px;min-height:18px;margin:4px 0 8px}
.r2{display:flex;justify-content:space-between;align-items:center;font-size:13px;margin-bottom:12px}
.lk{background:none;border:0;color:var(--mar);text-decoration:underline;padding:0;font:inherit}.lk:hover{filter:brightness(1.5)}
.au .sb{width:100%;padding:13px;font-size:15px;display:block;text-align:center;margin-bottom:10px}
.av{width:30px;height:30px;border-radius:50%;background:var(--mar);color:#fff;display:grid;place-items:center;font:700 14px Inter}
.or{display:flex;align-items:center;gap:10px;color:#777;font-size:12px;margin:6px 0 12px}.or:before,.or:after{content:"";flex:1;height:1px;background:#ddd}
.soc{display:flex;gap:10px;margin-bottom:14px}
.sc2{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;border:1px solid #ccc;background:#fff;border-radius:4px;padding:10px;font:600 14px Inter;transition:.2s}
.sc2:hover{box-shadow:0 4px 10px rgba(0,0,0,.15);transform:translateY(-2px);border-color:#999}.sc2:active{transform:scale(.96)}.sc2 svg{width:20px;height:20px;stroke:none}
.od{max-width:720px;margin:10px auto 40px}.od h2{font:700 26px Lora,serif;margin:0 0 14px}
.oc{border:1px solid #e3e3e3;border-radius:8px;padding:16px;margin-bottom:16px;box-shadow:0 1px 4px rgba(0,0,0,.08);transition:.2s}
.oc:hover{box-shadow:0 8px 18px rgba(0,0,0,.14);transform:translateY(-2px)}
.oh{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px}
.oh small,.oi small{display:block;color:#666;font-size:13px}
.ob{background:#f3e3e3;color:var(--mar);font:600 12px Inter;padding:4px 10px;border-radius:12px}
.oi{display:flex;gap:12px;align-items:center;padding:8px 0;border-top:1px solid #f0f0f0}
.oi img{width:56px;height:60px;object-fit:cover;border-radius:3px}.oi b{font:600 14px Inter}
.of{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #eee;padding-top:12px;margin-top:4px;font:700 16px Inter}
.on2{display:block;margin-top:8px;color:#666;font-size:13px}
.dt{display:inline-block;width:10px;height:10px;border-radius:50%;border:1px solid rgba(0,0,0,.25);margin-left:6px}
.f textarea{width:100%;margin-top:5px;padding:11px;border:1px solid #ccc;border-radius:4px;font:400 15px Outfit;resize:vertical;transition:.2s}
.f textarea:focus{border-color:var(--mar);outline:0;box-shadow:0 0 0 3px #71000022}
.pf{max-width:1920px}
.ol{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,560px),1fr));gap:16px;align-items:start}
.pc{display:flex;gap:20px;align-items:center;background:#fff;border-radius:8px;box-shadow:0 4px 18px rgba(0,0,0,.14);padding:22px;margin:26px 0 18px;flex-wrap:wrap}
.pc .av{width:72px;height:72px;font-size:32px;flex:none}
.pi{flex:1;min-width:200px}.pi h2{font:700 26px Lora,serif;margin:0 0 4px}.pi div{font-size:14px;color:#555;margin-top:2px}
.pa{display:flex;flex-direction:column;gap:8px;align-items:flex-end}.pa .sb{padding:10px 18px}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:26px}
.tl{background:#fff;border:1px solid #e5e5e5;border-radius:8px;padding:16px;text-align:center;transition:.2s}
.tl:hover{transform:translateY(-4px);box-shadow:0 8px 18px rgba(0,0,0,.14);border-color:var(--mar)}.tl:active{transform:scale(.96)}
.tl b{display:block;font:700 28px Inter;color:var(--mar)}.tl span{font:600 13px Inter}
.ots{display:flex;gap:6px;overflow-x:auto;margin-bottom:16px;border-bottom:1px solid #e5e5e5}
