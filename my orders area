about:()=>`<div class="wrap ab"><button class="bk" data-a="back">BACK</button><h1>About Us</h1><p>Welcome to Urban kind.a, where style meets individuality.<br>Founded in 2026, Urban kind.a began with a simple vision: to create a space where fashion feels personal, expressive, and accessible to everyone. What started as a small clothing shop has grown into a brand that celebrates confidence, creativity, and everyday style.</p><p>At Urban kind.a, we believe that clothing is more than just what you wear it’s how you tell your story. That’s why we carefully curate pieces that blend comfort, quality, and trend-forward design, making it easy for you to find outfits that truly reflect who you are. Whether you’re dressing up for a special occasion or keeping it casual, our collections are designed to make you feel confident in every moment. We’re passionate about helping our customers discover styles that fit their personality, mood, and lifestyle. As we continue to grow, our commitment remains the same: to bring you stylish, affordable, and thoughtfully chosen pieces that make you feel your best.</p><p>Thank you for being part of Urban kind.a your little space for fashion, confidence, and self-expression.</p><div class="fb"><img src="${IMG.logo}" alt="Urban Kinda" style="height:130px;mix-blend-mode:multiply"><img src="${IMG.wtw}" alt="What to wear?" style="max-width:100%;width:480px;margin-top:10px"></div></div>`,
favorites:()=>`<div class="wrap"><h1 class="ct">Favorites</h1>${grid(F.map(byId).filter(Boolean),`Nothing saved yet. Tap the heart on any piece to keep it here.<br>${shop}`)}</div>`,
search:q=>{const w=q.toLowerCase().split(/\s+/).filter(Boolean);const l=P.filter(p=>{const h=(p.n+" "+p.cat+" "+p.tags).toLowerCase().split(/[\s\/()]+/);return w.every(x=>h.some(y=>y.startsWith(x)))});return `<div class="wrap"><h1 class="ct">Results for “${q.replace(/</g,"&lt;")}”</h1>${grid(l,`No pieces match that. Try “jackets”, “men's wear” or “offers”.<br>${shop}`)}</div>`},
login:()=>{if(ME)return PG.account();const up=AT=="up";
 const pw=(id,l,ac)=>`<label class="f">${l}<span class="pw"><input id="${id}" type="password" required autocomplete="${ac}"><button type="button" data-a="eye" aria-label="Show password">Show</button></span></label>`;
 const tab=(t,l)=>`<button role="tab" aria-selected="${(t=="up")==up}" class="${(t=="up")==up?"on":""}" data-a="tab" data-t="${t}">${l}</button>`;
 return `<div class="wrap"><div class="split"><aside class="side"><p class="sc">Urban kind.a</p><h2>where style meets individuality.</h2><img src="${IMG.hero}" alt=""></aside><div class="au"><div class="tabs" role="tablist">${tab("in","Log in")}${tab("up","Sign up")}</div>`+(up?
 `<form id="sgf" novalidate><h2>Create your account</h2><p class="sub">Join Urban Kinda for faster checkout.</p><label class="f">Full name<input id="sn" type="text" required autocomplete="name"></label><label class="f">Email<input id="se" type="email" required autocomplete="email"></label><label class="f">Mobile number<input id="sph" type="tel" required autocomplete="tel" placeholder="+639123456789"></label>${pw("pw1","Password","new-password")}<div class="sm"><i id="bar2"></i></div><div id="stx" style="font-size:12px;color:#666;margin-bottom:12px">Use 8+ characters with letters and numbers.</div>${pw("pw2","Confirm password","new-password")}<label style="display:flex;gap:8px;align-items:flex-start;font-size:13px;margin:4px 0"><input id="sg" type="checkbox" style="margin-top:3px"> I agree to the Terms and Privacy Policy.</label><div class="er" role="alert"></div><button class="sb rp" type="submit">Create account</button>${SOC}<div class="r2" style="justify-content:center">Already have an account?&nbsp;<button type="button" class="lk" data-a="tab" data-t="in">Log in</button></div></form>`:
 `<form id="lgf" novalidate><h2>Welcome back</h2><p class="sub">Log in to your Urban Kinda account.</p><label class="f">Email<input id="le" type="email" required autocomplete="email"></label>${pw("lp","Password","current-password")}<div class="r2"><label><input id="rm" type="checkbox" checked> Remember me</label><button type="button" class="lk" data-a="forgot">Forgot password?</button></div><div class="er" role="alert"></div><button class="sb rp" type="submit">Log in</button>${SOC}<div class="r2" style="justify-content:center">New here?&nbsp;<button type="button" class="lk" data-a="tab" data-t="up">Create an account</button></div></form>`)+`</div></div></div>`},
account:()=>{if(!ME)return PG.login();
 const mine=ORD.filter(o=>o.who==ME.email),cnt=k=>mine.filter(o=>stOf(o)==k).length;
 const TB=[["all","All"],["ship","To Ship"],["recv","To Receive"],["done","Completed"],["ret","Return/Refund"],["x","Cancelled"]];
 const l=mine.filter(o=>OT=="all"||stOf(o)==OT),prv=mine.some(o=>!o.x&&(o.s||0)<4);
 const info=EDIT?`<form id="pfm" style="width:100%" novalidate><h2 style="font:700 24px Lora,serif;margin:0 0 12px">Edit profile</h2><label class="f">Full name<input id="pn" type="text" value="${esc(ME.name)}" autocomplete="name"></label><label class="f">Mobile number<input id="pp" type="tel" value="${esc(ME.phone)}" autocomplete="tel"></label><label class="f">Delivery address<textarea id="pa2" rows="2" autocomplete="street-address" placeholder="House no., street, barangay, city">${esc(ME.addr||"")}</textarea></label><div class="er" role="alert"></div><div style="display:flex;gap:14px;align-items:center"><button class="sb rp" type="submit">Save changes</button><button type="button" class="lk" data-a="canceledit">Cancel</button></div></form>`
 :`<span class="av">${esc(ME.name[0].toUpperCase())}</span><div class="pi"><h2>${esc(ME.name)}</h2><div>${esc(ME.email)}</div><div>${esc(ME.phone)}</div><div>${ME.addr?esc(ME.addr):"No delivery address yet"}</div></div><div class="pa"><button class="sb rp" data-a="edit">Edit profile</button><button class="lk" data-a="gocart">My bag</button><button class="lk" data-a="gofav">Favorites</button><button class="lk" data-a="logout">Log out</button></div>`;
 return `<div class="wrap pf"><div class="pc">${info}</div><div class="tiles">${[["ship","To Ship"],["recv","To Receive"],["done","Completed"]].map(x=>`<button class="tl" data-a="otab" data-t="${x[0]}" data-sc="1"><b>${cnt(x[0])}</b><span>${x[1]}</span></button>`).join("")}</div><h2 id="ords" style="font:700 26px Lora,serif;margin:0 0 10px">My orders</h2><div class="ots" role="tablist">${TB.map(x=>`<button role="tab" aria-selected="${OT==x[0]}" class="${OT==x[0]?"on":""}" data-a="otab" data-t="${x[0]}">${x[1]}${x[0]!="all"&&cnt(x[0])?`<em>${cnt(x[0])}</em>`:""}</button>`).join("")}</div>${prv?`<p class="on2" style="margin:0 0 14px">The dashed “Preview” button moves an order forward so you can see how tracking looks. Once your shop system is connected, orders will update by themselves.</p>`:""}<div class="ol">${l.length?l.map(otrack).join(""):`<div class="em" style="padding:30px 0">${mine.length?"No orders in this tab yet.":"No orders yet. Your orders will show up here after checkout."}<br><a class="sb rp" href="#categories" style="display:inline-block;margin-top:14px">Start shopping</a></div>`}</div></div>`},
