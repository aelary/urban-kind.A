.xo{opacity:.75}
@media (max-width:860px){.pa{align-items:flex-start;flex-direction:row;flex-wrap:wrap}.trk small{display:none}.trk b{font-size:10px}.tiles{gap:8px}}
.f select{width:100%;margin-top:5px;padding:11px;border:1px solid #ccc;border-radius:4px;font:400 15px Outfit;background:#fff}
.f select:focus{border-color:var(--mar);outline:0;box-shadow:0 0 0 3px #71000022}
.oa a{display:inline-block;border-radius:3px;padding:9px 14px;font:600 13px Inter;border:2px solid var(--mar);color:var(--mar);background:#fff;transition:.2s}
