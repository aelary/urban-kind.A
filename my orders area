.cl{display:grid;gap:10px}.cl a{display:block;text-align:center;padding:12px;border-radius:3px;font:600 14px Inter;border:2px solid var(--mar);color:var(--mar);transition:.2s}
.cl a:hover{background:#f7eaea;transform:translateY(-2px)}.cl a.main{background:var(--mar);color:#fff}.cl a.main:hover{background:var(--mar);filter:brightness(1.25)}
.rv{padding:10px 0;border-top:1px solid #eee}.rv b{font:600 14px Inter}
