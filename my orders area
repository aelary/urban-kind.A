.ots button:hover{color:var(--mar)}.ots button.on{color:var(--mar);border-color:var(--mar)}
.ots em{font-style:normal;background:#f3e3e3;color:var(--mar);border-radius:10px;font-size:11px;padding:1px 7px;margin-left:5px}
.trk{display:flex;list-style:none;padding:0;margin:6px 0 16px}
.trk li{flex:1;text-align:center;position:relative;color:#888}
.trk li:before{content:"";position:absolute;top:11px;left:-50%;right:50%;height:3px;background:#e2e2e2;transition:.3s}
